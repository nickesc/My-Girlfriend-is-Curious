{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mgic",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://mgic.nickesc.workers.dev",
    "SPOTIFY_CLIENT_ID": "f5d7a507662e4081869efb1771bbb129",
    "SPOTIFY_USER_ID": "goofyshnoofy",
    "IFTTT_EVENT": "spotify_reauthorization",
    "ALLOWED_ORIGINS": "https://nickesc.github.io,https://nickesc.io,https://www.nickesc.io",
  },
  "durable_objects": {
    "bindings": [{"name": "SPOTIFY_SESSION", "class_name": "SpotifySession"}],
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["SpotifySession"]}],
  "observability": {"enabled": false},
}
