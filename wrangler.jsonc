{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mgic",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "PUBLIC_BASE_URL": "",
    "SPOTIFY_CLIENT_ID": "",
    "SPOTIFY_USER_ID": "",
    "IFTTT_EVENT": "spotify_reauthorization",
    "ALLOWED_ORIGINS": "",
  },
  "durable_objects": {
    "bindings": [{"name": "SPOTIFY_SESSION", "class_name": "SpotifySession"}],
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["SpotifySession"]}],
  "observability": {"enabled": false},
}
